{
  "name": "@pistachio/shell-contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The shell's contracts: the IPC surface, the snapshot shapes, and the socket protocol shared by desktop main, the shell UI, the cloud-browser host and the web app.",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
