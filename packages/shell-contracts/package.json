    "@pistachio/protocol": "workspace:*",
    "@pistachio/reports": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@pistachio/sync-protocol": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "eslint": "^9.39.1",
    "typescript": "5.9.2",
    "vitest": "^3.2.0"
  }
}
