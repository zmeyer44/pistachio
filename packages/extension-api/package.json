{
  "name": "@pistachio/extension-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Pistachio extension API (docs/extensions.md): the manifest schema, the capabilities and their sheet lines, the wire between an extension and main, the published `pistachio` types, and the guide a coding agent reads.",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts",
    "./capabilities": "./src/capabilities.ts",
    "./wire": "./src/wire.ts",
    "./sheet": "./src/sheet.ts",
    "./runtime": "./src/runtime.ts",
    "./types": "./pistachio.d.ts",
    "./schema": "./schema/pistachio-extension.schema.json"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "schema": "node scripts/write-schema.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.0"
  }
}
