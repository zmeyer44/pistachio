{
  "name": "@pistachio/live-share",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Live share of a space: the room protocol, the desk geometry, ink, cursors, the LiveKit room and the React pieces the desktop host and the web guest both draw.",
  "exports": {
    ".": "./src/index.ts",
    "./room": "./src/room.ts",
    "./effects": "./src/effects.ts",
    "./assets": "./assets/index.mjs",
