    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint src test assets --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@livekit/track-processors": "0.8.1",
    "livekit-client": "2.22.3",
    "lucide-react": "0.468.0",
