{
  "name": "@pistachio/notes",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A note's document: the shared TipTap schema, HTML/markdown/JSON conversions that run without a browser, the agent's structural edit, plain text, and the self-contained page a note is published as (docs/notes.md §2).",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test --max-warnings 0"
  },
  "dependencies": {
    "@tiptap/core": "3.32.1",
    "@tiptap/extension-details": "3.32.1",
    "@tiptap/extension-image": "3.32.1",
    "@tiptap/extension-list": "3.32.1",
    "@tiptap/extension-table": "3.32.1",
    "@tiptap/markdown": "3.32.1",
    "@tiptap/pm": "3.32.1",
    "@tiptap/starter-kit": "3.32.1",
    "zeed-dom": "0.18.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "eslint": "^9.39.1",
    "typescript": "5.9.2",
    "vitest": "^3.2.0"
  }
}
