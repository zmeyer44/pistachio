FROM node:22-bookworm-slim

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

WORKDIR /app
COPY . .
RUN pnpm install --filter @pistachio/egress... --frozen-lockfile

ENV NODE_ENV=production
# Plain HTTP inside the machine: Fly's edge terminates TLS on 443
# (`handlers: ["tls"]`) and forwards the plaintext stream here.
EXPOSE 8443

CMD ["pnpm", "--filter", "@pistachio/egress", "start"]
