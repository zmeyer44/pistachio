{
  "name": "@pistachio/desktop",
  "version": "0.0.20",
  "productName": "Pistachio",
  "private": true,
  "type": "module",
  "description": "Pistachio native delegation browser",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "electron-vite build",
    "start": "node scripts/electron-vite.mjs preview",
    "check-types": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "pnpm build && playwright test -c e2e/playwright.config.ts",
    "lint": "eslint src test e2e --max-warnings 0",
    "dist:mac": "pnpm build && node scripts/dist-mac.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@pistachio/adapters": "workspace:*",
    "@pistachio/agent-runtime": "workspace:*",
    "@pistachio/egress-policy": "workspace:*",
    "@pistachio/evidence": "workspace:*",
    "@pistachio/live-view": "workspace:*",
    "@pistachio/notes": "workspace:*",
    "@pistachio/notifications": "workspace:*",
    "@pistachio/policy": "workspace:*",
    "@pistachio/protocol": "workspace:*",
    "@pistachio/reports": "workspace:*",
    "@pistachio/run-view": "workspace:*",
    "@pistachio/runtime": "workspace:*",
    "@pistachio/shell-contracts": "workspace:*",
    "@pistachio/smart-find": "workspace:*",
    "@pistachio/shell-ui": "workspace:*",
    "@pistachio/sync-engine": "workspace:*",
    "@pistachio/sync-protocol": "workspace:*",
    "@pistachio/watchtower": "workspace:*",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-slot": "^1.3.3",
    "@shadcn/react": "^0.3.0",
    "ai": "^7.0.107",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@swc/core": "^1.11.24",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "5.9.2",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
