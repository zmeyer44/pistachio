FROM node:22-bookworm-slim

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

WORKDIR /app
COPY . .
RUN pnpm install --filter @pistachio/control... --frozen-lockfile

ENV NODE_ENV=production
EXPOSE 8787

CMD ["pnpm", "--filter", "@pistachio/control", "start"]
