# Local development environment for the full cloud-sync stack.
#
# NOTHING HERE IS AUTO-LOADED. Turbo hashes `.env*` for caching but does not
# put it in the environment, and the services read `process.env` directly.
# Export these in your shell (direnv, `set -a; . ./.env; set +a`, or a
# `node --env-file` wrapper) before `pnpm dev`.
#
# `turbo` runs in strict env mode, so a variable must also be listed in
# `turbo.json`'s `globalEnv` to reach a task. Add it there when you add one
# here, or it is silently dropped and you debug a phantom.
#
# Each service's `dev-server.ts` fills in local defaults, so `pnpm dev` boots
# with none of this set — it just boots a stack whose parts cannot see each
# other. The sections below say what each one buys you.


# ── 1. Nothing. ───────────────────────────────────────────────────────────
# control      :8787  ephemeral signing keypair, PGlite at ./.pglite, MAILER=log
# cloud-browser:8791  dev service token, ephemeral state key, egress=direct
# egress       :8443  dev-insecure verifier on loopback
# www         :3000  the site and the dashboard; talks to http://localhost:8787
# web         :3001  the browser app; talks to the same control plane
# You can sign up, enrol a device and sync. You cannot run the cloud agent.


# ── 2. Let control drive the cloud browser. ───────────────────────────────
# Without the first two, control logs "cloud browser: disabled" and every run
# is refused. The token must match on both sides; the value below is the one
# cloud-browser's dev-server assumes.
CLOUD_BROWSER_URL=http://localhost:8791
CLOUD_BROWSER_SERVICE_TOKEN=dev-cloud-browser-service-token
# The URL control *advertises* in `/me`, as distinct from the one it calls.
# Leave it unset and `/me` returns `cloudBrowserUrl: null`, which is what the
# desktop gates its whole cloud-browser UI on — the feature stays greyed out
# with no error to explain why.
CLOUD_BROWSER_PUBLIC_URL=http://localhost:8791
# This worker's own address on the deployment's private network, recorded
# with each claimed run so a viewer that lands on another worker behind the
# shared public address can be handed over to the one running the browser
# (the in-fleet live-view hop). Unset in development: there is one worker.
# CLOUD_BROWSER_INTERNAL_URL=http://cloud-browser.railway.internal:8791
# How long a browser session stays claimed with no viewer attached and no run
# active before it publishes its sealed record and suspends (default 30 min).
# CLOUD_BROWSER_SESSION_IDLE_MS=1800000

# ── 3. Let the two web apps call control. ─────────────────────────────────
# There are two sites (docs/web-browser-design.md §15): `www` (the landing
# pages, the download, and the account dashboard) and `web` (the browser
# itself). They are separate origins with separate device keys, and both talk
# to this control plane.
#
# Control emits no CORS headers at all when this is unset, so every request
# from the browser fails preflight. Exact origins, comma separated; `*` is
# dropped on purpose, and there is no credentials mode — a browser device
# carries a bearer token, not a cookie. BOTH sites belong here.
CONTROL_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# `www`: secure iMessage onboarding and credential-capture links, the artifact
# tool views, and the live view's Origin for the dashboard's run page.
PISTACHIO_WEB_URL=http://localhost:3000
# `web`: the shell socket's Origin pin and the download route's CORS origin.
PISTACHIO_BROWSER_URL=http://localhost:3001
# What each site tells the browser about the other. `www`'s dashboard links to
# the browser app with the first; the browser app's gate and its "managed from
# the web app" affordances link back with the second.
NEXT_PUBLIC_PISTACHIO_BROWSER_URL=http://localhost:3001
NEXT_PUBLIC_PISTACHIO_WWW_URL=http://localhost:3000
# Where the Mac app is downloaded — the walkthrough's import step, on either
# site. Defaults to the public release bucket.
# NEXT_PUBLIC_PISTACHIO_DOWNLOAD_URL=

# ── 4. Let the agent think. ───────────────────────────────────────────────
# The operator's Vercel AI Gateway key. Control proxies every desktop model
# call through it (`/v1/ai/*`) and cloud-browser calls the gateway with it
# directly; the desktop holds no provider key of its own. Without it both
# warn at boot, control answers 503 `ai_gateway_unconfigured`, and every run
# fails at the first model call.
AI_GATEWAY_API_KEY=
# PISTACHIO_AGENT_MODEL=openai/gpt-5.6-terra
# The browser app makes the walkthrough's two model calls itself, over its own
# device token against the same proxy (docs/web-browser-design.md §14). These
# pin the models it asks for; the defaults are the desktop's.
# NEXT_PUBLIC_PISTACHIO_AGENT_MODEL=openai/gpt-5.6-terra
# NEXT_PUBLIC_PISTACHIO_STT_MODEL=openai/whisper-1
# The evaluation model the address bar asks what typed prose most likely
# means (docs/smart-suggestions.md). It is asked at most once per pause in
# typing, costs a fraction of a cent, and is metered as `evaluation-model`.
# `off` (or `0`/`false`) turns smart suggestions off for the whole install —
# desktop and every cloud-browser session — whatever each person's
# Settings → General → Search switch says.
# PISTACHIO_INTENT_MODEL=typesafe-ai/jev
# Override the gateway base URL control proxies to (default is Vercel's).
# AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v4/ai

# ── 5. Optional: exercise the identity egress gateway. ────────────────────
# The provider is already `static` under `pnpm dev` — control's dev-server
# sets EGRESS_STATIC_HOST, and EGRESS_PROVIDER defaults to static whenever
# that is set. What is missing is the shared secret: without it control boots
# with "egress: static (no EGRESS_TOKEN_SECRET — credentials disabled)" and
# mints no proxy credentials, so `/me` reports `egress: null`.
# Set the same secret on control and on the gateway and both sides agree, so
# the cloud browser and your Mac present one IP.
#   32 bytes as 64 lowercase hex characters — anything else fails at boot:
#   openssl rand -hex 32
# EGRESS_TOKEN_SECRET=
# EGRESS_STATIC_HOST=127.0.0.1
# EGRESS_STATIC_PORT=8443
# EGRESS_PROVIDER=static                # or `fly` for per-user machines
# CLOUD_BROWSER_EGRESS_MODE=gateway     # dev default is `direct`
# CLOUD_BROWSER_EGRESS_SCHEME=http      # the dev gateway speaks plain HTTP
# PISTACHIO_EGRESS_URL=http://127.0.0.1:8443   # desktop: pin the dev gateway
#
# `EGRESS_PROVIDER=fly` is the production shape: one Fly app per user with a
# dedicated static egress IPv4 (docs/cloud-sync-design.md §7.6). Do NOT set it
# under `pnpm dev` — provisioning creates real (billed) Fly apps and IPs. It
# needs all three of these plus EGRESS_TOKEN_SECRET; the token must be
# org-scoped (`fly tokens create org <slug>`), an app deploy token 401s at
# app creation. Build the image with
#   fly deploy . -c fly.egress-image.toml --build-only --push --remote-only \
#     --image-label "v1-$(git rev-parse --short HEAD)-$(date +%Y%m%d)"
# FLY_API_TOKEN=
# FLY_ORG_SLUG=personal
# FLY_EGRESS_IMAGE=registry.fly.io/pistachio-egress:<label>

# ── 6. Optional: iMessage through BlueBubbles. ────────────────────────────
# All four values are required together. BLUEBUBBLES_SERVER_URL must be
# reachable from control. Generate independent high-entropy secrets for the
# webhook and the keyed OTP digest, for example with `openssl rand -hex 32`.
# BLUEBUBBLES_SERVER_URL=https://your-bluebubbles-server.example
# BLUEBUBBLES_PASSWORD=
# BLUEBUBBLES_WEBHOOK_SECRET=
# IMESSAGE_OTP_SECRET=
#
# In BlueBubbles, create a `New Message` webhook pointing at control. The
# query secret is scrubbed from control's request logs:
#   https://your-control.example/v1/imessage/webhook?secret=<BLUEBUBBLES_WEBHOOK_SECRET>

# ── 7. Optional: Gmail for the agent (docs/integrations.md). ──────────────
# Both required together. A Google OAuth client of the **Desktop app** type
# from a project with the Gmail API enabled: its redirect is a loopback
# address on any port (nothing to register), and Google does not treat its
# secret as confidential, which is what lets the cloud device refresh tokens
# too. Never put a web (confidential) client here. Unset, Gmail is listed as
# unavailable in Settings → Integrations and nothing else changes.
# `gmail.readonly` / `gmail.modify` are restricted scopes: an unverified
# client shows Google's warning screen and is capped at 100 users.
# INTEGRATION_GMAIL_CLIENT_ID=
# INTEGRATION_GMAIL_CLIENT_SECRET=

# ── 8. Optional: point the desktop somewhere else. ────────────────────────
# The desktop defaults to localhost:8787 unpackaged, and discovers the hub
# from `/me`. Finder launches inherit no shell environment, so these only
# apply when you start it from a terminal.
# PISTACHIO_CONTROL_URL=http://localhost:8787
# PISTACHIO_HUB_URL=ws://localhost:8787/v1/hub/ws

# ── 9. Optional: durable local state. ─────────────────────────────────────
# Without these the signing keypair and the cloud browser's stored device
# identities are regenerated per boot, invalidating every issued token.
# CONTROL_TOKEN_SK=
# CONTROL_TOKEN_PK=
# Where the worker keeps what must survive a boot: each user's sealed device
# identity (`<dir>/<userId>/device.json`) and a browser session's downloaded
# files (`<dir>/<userId>/downloads/`, swept after 24 hours). Required by the
# worker's own config; `pnpm dev` defaults it to `./.cloud-browser` inside
# services/cloud-browser, so set it only to put that state somewhere else.
# CLOUD_BROWSER_STATE_DIR=./.cloud-browser
# CLOUD_BROWSER_STATE_KEY=              # base64, 32 bytes
# DATABASE_URL=pglite:./.pglite

# A dev boot runs CREATE TABLE, so it refuses a DATABASE_URL naming a remote
# host and uses the embedded database instead — the root `.env` is shared
# with other tooling, and a Postgres URL in it is usually another project's.
# Set this when the remote one is the deliberate target.
# CONTROL_DEV_ALLOW_REMOTE_DB=1
